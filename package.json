{
  "name": "otter-monorepo",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:l2": "vitest run --config vitest.l2.config.ts",
    "test:worker": "bun run --cwd apps/api test",
    "dev": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/api dev",
    "build": "bun run --cwd apps/web build",
    "deploy": "bun run build && bun run --cwd apps/api deploy",
    "deploy:check": "bun run build && bun run --cwd apps/api deploy:check",
    "verify:web": "bun run scripts/verify-web.ts",
    "macos:generate": "bash scripts/build-macos.sh generate",
    "macos:build": "bash scripts/build-macos.sh",
    "macos:test": "bash scripts/test-macos.sh",
    "macos:test:ui": "python3 scripts/test-macos-ui.py",
    "macos:package": "bun run macos:build && python3 scripts/verify-macos-package.py",
    "lint": "bash scripts/typecheck-parallel.sh",
    "typecheck": "bash scripts/typecheck-parallel.sh",
    "lint:biome": "bunx biome check .",
    "lint:biome:fix": "bunx biome check --write .",
    "test:e2e": "bun run --cwd apps/web playwright test --config e2e/playwright.config.ts",
    "test:e2e:bdd": "bunx playwright test",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,jsonc,css}": [
      "bunx biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "17.5.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "hono": "$hono",
    "vite": ">=8.3.0",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=4.0.4",
    "postcss": ">=8.5.25",
    "sharp": ">=0.35.4",
    "undici": "^7.29.0",
    "wrangler": "4.131.2",
    "nanoid": "^3.3.18",
    "ws": ">=8.21.0"
  },
  "dependencies": {
    "hono": "4.13.7"
  }
}
